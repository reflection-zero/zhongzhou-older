<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.zzyl.nursing.mapper.ChatMessageMapper">

    <resultMap type="ChatMessage" id="ChatMessageResult">
        <result property="id"          column="id"           />
        <result property="sessionId"   column="session_id"   />
        <result property="role"        column="role"         />
        <result property="content"     column="content"      />
        <result property="contextData" column="context_data" />
        <result property="createTime"  column="create_time"  />
    </resultMap>

    <select id="selectMessagesBySessionId" resultMap="ChatMessageResult">
        SELECT id, session_id, role, content, context_data, create_time
        FROM chat_message
        WHERE session_id = #{sessionId}
        ORDER BY create_time ASC
    </select>

    <select id="selectRecentMessages" resultMap="ChatMessageResult">
        SELECT id, session_id, role, content, context_data, create_time
        FROM chat_message
        WHERE session_id = #{sessionId}
        ORDER BY create_time DESC
        LIMIT #{limit}
    </select>

</mapper>
